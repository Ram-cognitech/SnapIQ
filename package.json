{
  "name": "snapiq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scan a document with your phone; it lands on the computer in front of you.",
  "scripts": {
    "dev": "wrangler dev",
    "migrate": "wrangler d1 migrations apply snapiq --local",
    "test": "vitest run",
    "test:local": "node scripts/test-local.mjs",
    "test:watch": "vitest",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "icons": "node scripts/icons.mjs",
    "dev:https": "wrangler dev --ip 0.0.0.0 --local-protocol https",
    "model": "node scripts/model.mjs",
    "scan": "node scripts/try.mjs"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.30.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
